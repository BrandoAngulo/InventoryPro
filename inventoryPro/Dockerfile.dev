# ==========================================
# Dockerfile.dev (Entorno de Desarrollo Backend Java 21 + Maven)
# ==========================================
FROM maven:3.9.9-eclipse-temurin-21-alpine

WORKDIR /app

# Copiar archivos de configuración de Maven
COPY pom.xml ./
COPY .mvn .mvn
COPY mvnw mvnw.cmd ./

# Asegurar saltos de línea LF en mvnw y dar permisos de ejecución
RUN sed -i 's/\r$//' mvnw && chmod +x mvnw

# Pre-descargar dependencias para acelerar construcciones en desarrollo
RUN ./mvnw dependency:go-offline -B || mvn dependency:go-offline -B || true

# Copiar código fuente
COPY src ./src

# Exponer el puerto del Backend
EXPOSE 8080

# Ejecutar Spring Boot en modo desarrollo
CMD ["./mvnw", "spring-boot:run"]
